# Copy to .env and fill in real values:  cp .env.example .env
# Never commit .env. Only this example file belongs in git.

# ---- Backend server ----
Port=8080
Host=localhost
# Public base URL used to build short links (no trailing slash).
# Local: http://localhost:8080   Production: https://your-short-domain.com
BaseURL=http://localhost:8080
Debug=false

# ---- PostgreSQL ----
DBHost=localhost
DBPort=5432
DBUser=your_db_user
DBPassword=change-me
DBName=url_shortener
# Use "disable" locally. In production use "require" or "verify-full".
DBSSLMode=disable

# ---- Redis ----
CacheHost=localhost
CachePort=6379
CacheDB=0
# Leave empty if your local Redis has no password.
CachePassword=
# "true" for managed Redis that requires TLS.
CacheTLS=false
# How long a link stays cached (Go duration, minimum 1m). Default 24h.
CacheTTL=24h

# ---- URL safety (optional) ----
# Google Safe Browsing API key. If empty, only the local blocklist is used.
SafeBrowsingAPIKey=
# Path to a file with one blocked domain per line (see blocklist.example.txt).
BlocklistFile=blocklist.txt
# "true" = refuse to create links when Safe Browsing can't be reached.
# "false" = allow them and log the error.
SafeBrowsingFailClosed=false